{
  "java.completion.filteredTypes": [
    "com.sun.*",
    "sun.*",
    "jdk.*",
    "org.graalvm.*",
    "io.micrometer.shaded.*"
  ],
  "java.project.sourcePaths": [
    "src"
  ],
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/usr/lib/jvm/java-25-openjdk",
      "default": true
    }
  ],

  "java.addExports": [
      "javax.swing",
      "java.awt"
  ]
}